<Window x:Class="WindowRail.WindowPicker"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="添加窗口 · 窗栏" Width="540" Height="570" MinWidth="430" MinHeight="420"
 WindowStartupLocation="CenterScreen" Background="#F7F9FC" Foreground="#18263B"
 FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" ShowInTaskbar="False">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="15,8"/><Setter Property="Background" Value="#EAF0F6"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bg" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Margin="25">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="添加窗口" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="每份文档分别添加，点击名称即可切换。" Foreground="#627289" Margin="0,7,0,18"/></StackPanel>
  <Grid Grid.Row="1" Margin="0,0,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBox x:Name="SearchBox" Padding="10,8" BorderBrush="#D6DFE9" BorderThickness="1" VerticalContentAlignment="Center" TextChanged="Search_Changed" AutomationProperties.Name="搜索窗口或程序" ToolTip="搜索窗口名称或程序名称"/>
   <Button Grid.Column="1" Content="刷新" Margin="10,0,0,0" Click="Refresh_Click"/>
  </Grid>
  <Border Grid.Row="2" Background="White" BorderBrush="#E0E7EF" BorderThickness="1" CornerRadius="10">
   <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="6">
     <ItemsControl x:Name="ChoicesList"><ItemsControl.ItemTemplate><DataTemplate>
      <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}" HorizontalContentAlignment="Stretch" Padding="8,9" Margin="2" VerticalContentAlignment="Center" ToolTip="{Binding Hint}" Checked="Selection_Changed" Unchecked="Selection_Changed" AutomationProperties.Name="{Binding Label}">
       <Grid Margin="6,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="29"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Image Source="{Binding Icon}" Width="24" Height="24" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Margin="8,0,8,0"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" FontWeight="Medium"/><TextBlock Text="{Binding Detail}" Foreground="#7B8A9F" FontSize="11" Margin="0,4,0,0"/></StackPanel>
       </Grid>
      </CheckBox>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </ScrollViewer>
    <TextBlock x:Name="EmptyText" Text="正在查找已打开的窗口…" Foreground="#7B8A9F" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
   </Grid>
  </Border>
  <CheckBox x:Name="PinCheck" Grid.Row="3" Content="同时固定所属程序，关闭后也保留启动入口" Foreground="#52647C" FontSize="12" Margin="0,17,0,17"/>
  <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="CountText" Text="可多选" Foreground="#7B8A9F" VerticalAlignment="Center" FontSize="12"/>
   <Button Grid.Column="1" Content="取消" Click="Cancel_Click" Margin="0,0,9,0" IsCancel="True"/>
   <Button x:Name="ConfirmButton" Grid.Column="2" Content="添加所选" Foreground="White" Background="#187B75" Click="Confirm_Click" IsEnabled="False" IsDefault="True"/>
  </Grid>
 </Grid>
</Window>
