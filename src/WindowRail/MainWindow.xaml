<Window x:Class="WindowRail.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="窗栏 · WindowRail" WindowStyle="None" ResizeMode="NoResize"
 AllowsTransparency="True" Background="Transparent" Topmost="True"
 ShowActivated="False" ShowInTaskbar="False" SizeToContent="Height" Width="224"
 FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13"
 UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.Resources>
  <SolidColorBrush x:Key="RailText" Color="#F5F7FA" />
  <SolidColorBrush x:Key="RowSurface" Color="#01000000" />
  <DropShadowEffect x:Key="LabelShadow" Color="#000000" Opacity="0.9" BlurRadius="5" ShadowDepth="1" />
  <Style x:Key="ChromeButton" TargetType="Button">
   <Setter Property="Foreground" Value="{DynamicResource RailText}"/><Setter Property="Background" Value="#01000000"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Focusable" Value="False"/><Setter Property="Padding" Value="8,3"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter x:Name="Glyph" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8" Effect="{DynamicResource LabelShadow}"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Glyph" Property="Opacity" Value="1"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="RowButton" TargetType="Button">
   <Setter Property="Foreground" Value="{DynamicResource RailText}"/>
   <Setter Property="Focusable" Value="False"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Margin" Value="0,2"/><Setter Property="Height" Value="42"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" CornerRadius="10" Background="{DynamicResource RowSurface}">
     <Grid>
      <Border x:Name="ActiveLine" Width="3" Height="17" CornerRadius="1.5" Background="#83E1C7" HorizontalAlignment="Left" Margin="1,0,0,0" Visibility="Collapsed"/>
      <ContentPresenter Margin="10,0,9,0" VerticalAlignment="Center"/>
     </Grid>
    </Border>
    <ControlTemplate.Triggers>
     <DataTrigger Binding="{Binding Active}" Value="True"><Setter Property="Foreground" Value="#F5F7FA"/><Setter TargetName="Surface" Property="Background" Value="#A0274949"/><Setter TargetName="ActiveLine" Property="Visibility" Value="Visible"/></DataTrigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#F5F7FA"/><Setter TargetName="Surface" Property="Background" Value="#C52C3A4D"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <StackPanel Margin="5" AllowDrop="True" DragOver="Rail_DragOver" Drop="Rail_Drop">
  <Grid Height="27" Margin="0,0,0,3">
   <Border x:Name="Grip" Background="#01000000" CornerRadius="7" Width="42" Height="21" HorizontalAlignment="Center" Cursor="SizeAll" ToolTip="拖动移动窗栏" MouseLeftButtonDown="Grip_MouseDown">
    <TextBlock Text="⠿" Foreground="{DynamicResource RailText}" Effect="{DynamicResource LabelShadow}" Opacity="0.8" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
   </Border>
   <Button x:Name="MenuButton" Content="···" Width="27" Height="21" HorizontalAlignment="Right" Style="{StaticResource ChromeButton}" Click="Menu_Click" ToolTip="外观、隐藏和退出" AutomationProperties.Name="窗栏菜单"/>
  </Grid>
  <ScrollViewer x:Name="RowsScroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" MaxHeight="600" PanningMode="VerticalOnly">
   <ItemsControl x:Name="Rows" ItemsSource="{Binding Entries}">
    <ItemsControl.ItemTemplate><DataTemplate>
     <Button Style="{StaticResource RowButton}" Click="Row_Click" PreviewMouseLeftButtonDown="Row_MouseDown" PreviewMouseMove="Row_MouseMove" PreviewMouseRightButtonUp="Row_RightClick" ToolTip="{Binding Hint}" AutomationProperties.Name="{Binding AccessibleName}">
      <Grid Opacity="{Binding ContentOpacity}">
       <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/></Grid.ColumnDefinitions>
       <Grid Width="23" Height="23">
        <TextBlock Text="{Binding Fallback}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        <Image Source="{Binding Icon}" Stretch="Uniform"/>
       </Grid>
       <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="7,0,3,0" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Effect="{DynamicResource LabelShadow}"/>
       <TextBlock Grid.Column="2" Text="⌖" Foreground="{DynamicResource RailText}" FontSize="13" VerticalAlignment="Center" Opacity="0.6">
        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsProgram}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
       </TextBlock>
      </Grid>
     </Button>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
  </ScrollViewer>
  <Border x:Name="EmptyHint" Background="#C51E2938" CornerRadius="11" Padding="14,13" Margin="0,3,0,5">
   <StackPanel><TextBlock Text="把常用窗口放在手边" Foreground="#F5F7FA" FontSize="13"/><TextBlock Text="点击 ＋，添加文档或应用" Foreground="#AEBFD2" FontSize="11" Margin="0,5,0,0"/></StackPanel>
  </Border>
  <Button x:Name="AddButton" Content="＋" FontSize="23" Height="32" Width="44" Margin="0,6,0,0" HorizontalAlignment="Center" Style="{StaticResource ChromeButton}" Click="Add_Click" ToolTip="添加已打开的窗口" AutomationProperties.Name="添加窗口"/>
  <Border x:Name="ToastBorder" Background="#ED263447" CornerRadius="9" Padding="10,8" Margin="0,7,0,0" Visibility="Collapsed">
   <TextBlock x:Name="ToastText" Foreground="#EFF6FF" FontSize="11" TextWrapping="Wrap"/>
  </Border>
 </StackPanel>
</Window>
